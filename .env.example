# -----------------------------------------------------------------------------
# Open Source Analytics Platform Configuration
# -----------------------------------------------------------------------------

# Next.js Presentation Gateway Port
PORT=3000

# Rust Analytics Engine URL (Target of reverse proxy rewrites)
RUST_ENGINE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database Connection (SeaORM Multi-Database Layer)
# -----------------------------------------------------------------------------
# Default: Local SQLite database file (mode=rwc creates if not exists)
DATABASE_URL=sqlite://analytics.db?mode=rwc

# PostgreSQL Example:
# DATABASE_URL=postgres://analytics_user:secret_pass@localhost:5432/analytics_db

# MySQL Example:
# DATABASE_URL=mysql://analytics_user:secret_pass@localhost:3306/analytics_db
